# Frontend
VITE_API_URL=http://127.0.0.1:8001

# Backend: reemplaza usuario, contrasena, host y base con tus datos reales.
DATABASE_URL=mysql+pymysql://usuario:contrasena@127.0.0.1:3306/practicas_profesionales

# SMTP (envio de correos)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_app_password
SMTP_FROM=tu_correo@gmail.com
SMTP_STARTTLS=1
SMTP_SSL=0

# Congelar/activar envio de correos sin eliminar funcionalidad
# 1 = activo, 0 = pausado
EMAIL_FEATURE_ENABLED=1
EMAIL_QUEUE_WORKER_ENABLED=1

# Worker de cola de correos
EMAIL_QUEUE_POLL_SECONDS=30
EMAIL_QUEUE_BATCH_SIZE=20
EMAIL_QUEUE_MAX_RETRIES=3

# Usa una cadena aleatoria larga. No subas el archivo .env a Git.
JWT_SECRET_KEY=reemplaza-por-una-clave-aleatoria-de-al-menos-32-caracteres

# Origenes permitidos, separados por coma.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
