# Frontend
VITE_API_URL=http://127.0.0.1:8000

# Backend: reemplaza usuario, contrasena, host y base con tus datos reales.
DATABASE_URL=mysql+pymysql://usuario:contrasena@127.0.0.1:3306/practicas_profesionales

# Usa una cadena aleatoria larga. No subas el archivo .env a Git.
JWT_SECRET_KEY=reemplaza-por-una-clave-aleatoria-de-al-menos-32-caracteres

# Origenes permitidos, separados por coma.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Documentacion interactiva de FastAPI. Mantener apagada en produccion.
API_DOCS_ENABLED=false

# Correo SMTP para enviar credenciales temporales.
EMAIL_ENABLED=false
SHOW_TEMP_PASSWORDS_IN_RESPONSE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME="Sistema de Practicas Profesionales"
SMTP_FROM_ADDRESS=
SMTP_USE_TLS=true
FRONTEND_URL=http://localhost:5173
